# Optional. Without this key, Sidekick uses its built-in explainable demo advisor.
AI_PROVIDER=auto
# Set to 1 for an immediate, fully offline rehearsal/recording.
SIDEKICK_OFFLINE=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Zero-cost AI fallback. Free-tier prompts may be used to improve Google products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional. Enables live local concerts, sports, and festivals.
# Without it, Sidekick uses live public holidays plus clearly labeled demo events.
TICKETMASTER_API_KEY=

# Frontend dev server uses this by default.
VITE_API_URL=http://localhost:8000
