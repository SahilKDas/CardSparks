# Optional. Without this key, Sidekick uses its built-in explainable demo advisor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional. Enables live local concerts, sports, and festivals.
# Without it, Sidekick uses live public holidays plus clearly labeled demo events.
TICKETMASTER_API_KEY=

# Frontend dev server uses this by default.
VITE_API_URL=http://localhost:8000
